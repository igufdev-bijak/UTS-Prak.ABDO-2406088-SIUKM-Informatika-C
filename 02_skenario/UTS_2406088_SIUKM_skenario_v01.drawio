<mxCell id="gen34" value="10. Sistem menolak penyimpanan dan menampilkan pesan kuota penuh; tidak ada pendaftaran tersimpan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="810" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen35" value="11. Peserta memilih mencetak kartu peserta (cabang dari langkah 8; condition [pendaftaran berstatus Terdaftar dan peserta memilih mencetak kartu peserta]; extension point Pendaftaran tercatat)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="858" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="gen36" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="858" width="480" height="84" as="geometry"/></mxCell>
<mxCell id="gen37" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="942" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen38" value="12. Sistem menghasilkan kartu peserta berisi nomor pendaftaran dan data kegiatan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="942" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen39" value="13. Peserta memilih membatalkan pendaftaran (cabang dari langkah 8; condition [pendaftaran berstatus Terdaftar dan belum dikonfirmasi serta peserta memilih membatalkan]; extension point Pendaftaran tercatat)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="990" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="gen40" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="990" width="480" height="84" as="geometry"/></mxCell>
<mxCell id="gen41" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1074" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen42" value="14. Sistem mengubah status pendaftaran menjadi Dibatalkan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="1074" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen43" value="Skenario Akhir" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#F2F2F2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1122" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="gen44" value="Use case selesai jika pendaftaran tersimpan dengan status Terdaftar; kartu peserta dapat dicetak setelah pendaftaran tercatat; status menjadi Dibatalkan jika Peserta membatalkan pendaftaran yang belum dikonfirmasi; jika kuota penuh, tidak ada pendaftaran yang tersimpan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="1122" width="480" height="84" as="geometry"/></mxCell>
<mxCell id="gen45" value='Keterangan:&lt;br&gt;- Include: UC02 Daftar Kegiatan → UC03 Periksa Kuota Peserta (wajib, dijalankan sebelum penyimpanan).&lt;br&gt;- Extend: UC04 Cetak Kartu Peserta → UC02; condition [pendaftaran berstatus Terdaftar dan peserta memilih mencetak kartu peserta]; extension point Pendaftaran tercatat.&lt;br&gt;- Extend: UC05 Batalkan Pendaftaran → UC02; condition [pendaftaran berstatus Terdaftar dan belum dikonfirmasi serta peserta memilih membatalkan]; extension point Pendaftaran tercatat.&lt;br&gt;- Langkah 11–14 adalah perilaku extend, bukan langkah wajib UC02.&lt;br&gt;- Asumsi: status pendaftaran adalah Terdaftar dan Dibatalkan; "belum dikonfirmasi" berarti pendaftaran berstatus Terdaftar tetapi belum melewati batas konfirmasi Pengurus UKM.' style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="1224" width="900" height="178" as="geometry"/></mxCell>
