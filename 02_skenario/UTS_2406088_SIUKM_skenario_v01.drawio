<mxCell id="gen8" value="Peserta memperoleh pendaftaran kegiatan UKM yang kuotanya masih tersedia, dengan status Terdaftar." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="480" height="44" as="geometry"/></mxCell>
<mxCell id="gen9" value="Deskripsi" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="194" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="gen10" value="Peserta memilih kegiatan, mengisi data pendaftaran, lalu menyimpan pendaftaran. Sebelum disimpan, sistem menjalankan Periksa Kuota Peserta (include UC03). Pendaftaran tersimpan berstatus Terdaftar. Setelah pendaftaran tercatat, Peserta dapat mencetak kartu peserta atau membatalkan pendaftaran yang belum dikonfirmasi melalui perilaku extend." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="194" width="480" height="100" as="geometry"/></mxCell>
<mxCell id="gen11" value="Kegiatan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#F2F2F2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="294" width="420" height="28" as="geometry"/></mxCell>
