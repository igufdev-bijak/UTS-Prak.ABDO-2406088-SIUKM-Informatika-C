<mxCell id="gen29" value="8. Sistem menampilkan nomor pendaftaran, status Terdaftar, dan pilihan cetak kartu atau batalkan." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="686" width="480" height="48" as="geometry"/></mxCell>
<mxCell id="gen30" value="Skenario Alternative" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#E6E6E6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="734" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="gen31" value="9. Kuota kegiatan sudah penuh saat pemeriksaan (cabang dari langkah 6)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="762" width="420" height="48" as="geometry"/></mxCell>
<mxCell id="gen32" value="" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="762" width="480" height="48" as="geometry"/></mxCell>
